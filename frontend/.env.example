# Copy this file to .env and fill values before running dev server
# VITE_API_URL sengaja gak ada lagi -- API call sekarang same-origin (/api),
# dev pun diteruskan lewat proxy di vite.config.ts.
VITE_PUSHER_KEY=your-pusher-key-here
VITE_PUSHER_CLUSTER=mt1
# Optional: if using custom host/port
VITE_PUSHER_HOST=
VITE_PUSHER_PORT=443
